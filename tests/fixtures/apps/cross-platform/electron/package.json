{
  "name": "pincer-test-harness-electron",
  "version": "1.0.0",
  "description": "pincer Electron test harness — loads the same shared/web/index.html as PincerTestHarness.WebView",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:linux": "electron . --no-sandbox --disable-gpu --force-renderer-accessibility",
    "start:macos": "electron . --force-renderer-accessibility",
    "build": "electron-builder --win portable --x64",
    "build:linux": "electron-builder --linux dir --x64",
    "build:macos": "electron-builder --mac dir --universal"
  },
  "devDependencies": {
    "electron": "39.8.5",
    "electron-builder": "25.0.5"
  },
  "build": {
    "appId": "io.github.modcritic.pincer.harness.electron",
    "productName": "PincerTestHarness.Electron",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [{
        "target": "portable",
        "arch": ["x64"]
      }]
    },
    "linux": {
      "target": [{
        "target": "dir",
        "arch": ["x64"]
      }],
      "category": "Development"
    },
    "portable": {
      "artifactName": "PincerTestHarness.Electron.exe"
    }
  }
}
